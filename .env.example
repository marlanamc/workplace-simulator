# Copy to .env.local for local development, or run `vercel env pull --yes`.
# These are the only two variables the app reads.

# Neon Postgres. Read lazily (src/lib/db/client.ts) so the build does not need
# it, but every page and every sign-in does.
DATABASE_URL=postgresql://user:password@host/workplace?sslmode=require

# Signs the session cookie (src/lib/auth.ts). Without it the app still builds
# and /login still renders — it throws the moment someone presses Add, so
# nobody can sign in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me
